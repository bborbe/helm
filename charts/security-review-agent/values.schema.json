{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "security-review-agent values",
  "description": "Schema guarding the values contract. Defends against silently-ignored config by rejecting unknown keys and typing the enums. The auth path requires an existing-secret name for the agent. No watcher in v1 (iteration 2).",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent"],
  "properties": {
    "namespace": {
      "type": "string",
      "description": "PER-CLUSTER target namespace. Required at install time (validated by common.namespace)."
    },
    "stage": {
      "type": "string",
      "description": "PER-CLUSTER stage label; disambiguates the cluster-scoped PriorityClass."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string" } }
          }
        }
      }
    },
    "affinity": { "type": "object" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "assignee",
        "image",
        "existingSecret",
        "taskTypes",
        "triggerPhases",
        "triggerStatuses"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "assignee": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Name of an existing Secret -> Config.spec.secretName. Required — the chart never creates it."
        },
        "taskTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "triggerPhases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["todo", "planning", "execution", "ai_review", "human_review", "done"]
          }
        },
        "triggerStatuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["backlog", "next", "in_progress", "hold", "completed", "aborted"]
          }
        },
        "heartbeat": { "type": "string" },
        "concurrency": { "type": "integer", "minimum": 1 },
        "maxConcurrentJobs": { "type": "integer", "minimum": 1 },
        "priorityValue": { "type": "integer" },
        "volumeMountPath": { "type": "string" },
        "storageSize": { "type": "string" },
        "resources": {
          "type": "object",
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
